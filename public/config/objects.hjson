{
  debug: {
    interactions: true,
    showSocketHelpers: true
  },

  objects: {

    default: {
      scene: {
        background: "#111111",

        camera: {
          fov: 50,
          position: [0, 0, 7]
        },

        // Camera framing helpers
        // Base padding multiplier for fit; larger pushes camera back slightly
        fitPadding: 1.0,
        // Extra scale applied only when aspect < 1 (portrait). >1.0 moves camera further back.
        fitPaddingPortraitScale: 1.1,

        lights: {
          directional: {
            color: "#ffffff",
            intensity: 3.0,
            position: [3, 5, 2]
          },
          ambient: {
            color: "#ffffff",
            intensity: 0.4
          }
        }
      },

      interaction: {
        // Drag responsiveness (higher = more rotation per pixel)
        spinAcceleration: 2.0,
        // 0 = never stops, 1 = instant stop (frame-rate independent)
        spinFriction: 0.4,
        // Initial gentle spin on load (rad/s)
        idleSpinImpulse: 0.2,
        // Minimum angular speed before stopping (rad/s)
        minAngularSpeed: 0.5,
        // Extra initial yaw spin on load (rad/s), obeys normal friction
        initialYawSpin: 10.0,
        // Gentle upright correction (0 = none)
        uprightStrength: 0.25,
        // Spin speed threshold below which upright correction activates (rad/s)
        uprightThreshold: 0.6,
        // Touch spin boost multiplier relative to mouse drag
        touchSpinBoost: 6.0,

        // Zoom controls
        zoomSpeed: 0.002,
        pinchZoomMultiplier: 16.0,
        minZoom: 2,
        maxZoom: 12,

        // Axis multipliers (dampen x more than y, etc.)
        xAxisMultiplier: 0.2,
        yAxisMultiplier: 1.0,

        socketVisibilityIntervalMs: 500,

        // Drag visuals
        dragOpacity: 0.4,

        // Socket selection radius (multiplier of base radius)
        socketSelectionRadius: 0.30,

        // Drag plane radius scale (1.0 = at surface; >1 in front; <1 slightly inside)
        dragPlaneRadiusScale: 1.0
      }
    },

    hoon_dog: {
      objClass: "base"
      modelPath: "/assets/objects/hoon_dog/hoon_dog.glb"
      thumbnail: "/assets/objects/hoon_dog/hoon_dog_thumb.png"
      displayName: "Hoon Dog"
      size: 10
      sizeRank: 6
      influence: { radius: 0.1 }
      sockets: [
        { id: "socket_p_0", role: "parent", positionHint: "top of head",    rotationOffset: [0, 0, 0] }
        { id: "socket_p_1", role: "parent", positionHint: "nose",           rotationOffset: [0, 0, 0] }
        { id: "socket_p_2", role: "parent", positionHint: "right cheek",    rotationOffset: [0, 0, 0] }
        { id: "socket_p_3", role: "parent", positionHint: "back of head",   rotationOffset: [0, 0, 0] }
        { id: "socket_p_4", role: "parent", positionHint: "left cheek",     rotationOffset: [0, 0, 0] }
        { id: "socket_p_5", role: "parent", positionHint: "chest",          rotationOffset: [0, 0, 0] }
        { id: "socket_p_6", role: "parent", positionHint: "right neck",     rotationOffset: [0, 0, 0] }
        { id: "socket_p_7", role: "parent", positionHint: "saddle/back",    rotationOffset: [0, 0, 0] }
        { id: "socket_p_8", role: "parent", positionHint: "left neck",      rotationOffset: [0, 0, 0] }
        { id: "socket_p_9", role: "parent", positionHint: "right side",     rotationOffset: [0, 0, 0] }
        { id: "socket_p_10", role: "parent", positionHint: "butthole",      rotationOffset: [0, 0, 0] }
        { id: "socket_p_11", role: "parent", positionHint: "left side",     rotationOffset: [0, 0, 0] }
      ]
    }

    full_face: {
      objClass: "accessory"
      modelPath: "/assets/objects/full_face/full_face.glb"
      thumbnail: "/assets/objects/full_face/full_face_thumb.png"
      displayName: "Full Face"
      size: 4
      sizeRank: 5
      influence: { radius: 0.15 }
      sockets: [
        { id: "socket_c_0", role: "child",  positionHint: "inside",      rotationOffset: [0, 0, 0] }
        { id: "socket_p_0", role: "parent", positionHint: "forehead",    rotationOffset: [0, 0, 0] }
        { id: "socket_p_1", role: "parent", positionHint: "left temple", rotationOffset: [0, 0, 0] }
        { id: "socket_p_2", role: "parent", positionHint: "left cheek",  rotationOffset: [0, 0, 0] }
        { id: "socket_p_3", role: "parent", positionHint: "right cheek", rotationOffset: [0, 0, 0] }
        { id: "socket_p_4", role: "parent", positionHint: "right temple",rotationOffset: [0, 0, 0] }
        { id: "socket_p_5", role: "parent", positionHint: "nose",rotationOffset: [0, 0, 0] }
      ]
      allowedSockets: {
        hoon_dog: ["socket_p_1", "socket_p_3", "socket_p_5"]
      }
    }

    half_face: {
      objClass: "accessory"
      modelPath: "/assets/objects/half_face/half_face.glb"
      thumbnail: "/assets/objects/half_face/half_face_thumb.png"
      displayName: "Half Face"
      size: 3.2
      sizeRank: 4
      influence: { radius: 0.15 }
      sockets: [
        { id: "socket_c_0", role: "child",  positionHint: "inside",      rotationOffset: [0, 0, 0] }
        { id: "socket_p_0", role: "parent", positionHint: "right cheek",    rotationOffset: [0, 0, 0] }
        { id: "socket_p_1", role: "parent", positionHint: "left cheek", rotationOffset: [0, 0, 0] }
        { id: "socket_p_2", role: "parent", positionHint: "nose",  rotationOffset: [0, 0, 0] }
      ]
      allowedSockets: {
        hoon_dog: ["socket_p_1", "socket_p_3", "socket_p_5", "socket_p_10"]
        full_face: ["socket_p_5"]
      }
    }

    piggy_face1: {
      objClass: "accessory"
      modelPath: "/assets/objects/piggy_face1/piggy_face1.glb"
      thumbnail: "/assets/objects/piggy_face1/piggy_face1_thumb.png"
      displayName: "Piggy Face"
      size: 2.66
      sizeRank: 3.5
      influence: { radius: 0.12 }
      sockets: [
        { id: "socket_c_0", role: "child",  positionHint: "inside",      rotationOffset: [0, 0, 0] }
        { id: "socket_p_0", role: "parent", positionHint: "forehead",    rotationOffset: [0, 0, 0] }
        { id: "socket_p_1", role: "parent", positionHint: "right cheek", rotationOffset: [0, 0, 0] }
        { id: "socket_p_2", role: "parent", positionHint: "left cheek",  rotationOffset: [0, 0, 0] }
      ]
      allowedSockets: {
        hoon_dog: ["socket_p_1", "socket_p_3", "socket_p_5", "socket_p_10"]
        full_face: ["socket_p_0", "socket_p_5"]
        half_face: ["socket_p_2"]
      }
    }

